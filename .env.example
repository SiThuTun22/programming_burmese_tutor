# Hugging Face (optional if unsloth/gemma-3-4b-it is already cached)
HF_TOKEN=

# LoRA on Hub (gitignored locally). Download: scripts/download_adapter.py
TUTOR_ADAPTER_HF_REPO=SiThuTun22/programming-burmese-tutor-lora

# Pascal / 8GB GPU stability (set before loading torch)
TORCH_COMPILE_DISABLE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Model paths
TUTOR_BASE_MODEL=google/gemma-3-4b-it
TUTOR_ADAPTER=outputs/lora_adapter
TUTOR_MAX_NEW_TOKENS=256
TUTOR_NO_REPEAT_NGRAM=12
TUTOR_REPETITION_PENALTY=1.12
# Inference device map: default single-GPU; set to auto only if you know you need it
# TUTOR_DEVICE_MAP=auto
TUTOR_MIN_VRAM_GIB=5

# Gradio UI (make app / make serve)
TUTOR_HOST=0.0.0.0
TUTOR_PORT=7860

# Litestar API (optional: make serve-api)
TUTOR_API_HOST=0.0.0.0
TUTOR_API_PORT=8001
# TUTOR_CORS_ORIGINS=http://localhost:7860

# Optional: require X-API-Key on POST /v1/chat
# TUTOR_API_KEY=
# TUTOR_MAX_CODE_CHARS=16384

# Gradio read-aloud (edge-tts; needs outbound internet)
TUTOR_TTS_ENABLED=true
TUTOR_TTS_VOICE=my-MM-ThihaNeural
TUTOR_TTS_AUTOPLAY=false

# Append inference guide from data/inference_prompt.md (inference + chat SFT export)
TUTOR_STYLE_GUIDE=true
# TUTOR_INFERENCE_PROMPT_PATH=data/inference_prompt.md
