# Programming questions skip embed. MIIT-like questions use gemini-embedding-001 after make miit-index.
TUTOR_BACKEND=hybrid
HYBRID_CHAT_PROVIDER=gemini
GEMINI_API_KEY=
# Optional second Google key: chat only if GEMINI_API_KEY hits free-tier 429/quota.
# Not used for embeddings, TTS names, or Ask routing. Empty = primary key only.
GEMINI_API_KEY_FALLBACK=
# Optional second Google key: TTS person-name JSON + Ask routing only.
# Never used for the chat answer. Empty = no router call; retrieve_miit as before.
GEMINI_TTS_NAMES_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
TUTOR_CLOUD_MAX_TOKENS=3072
TUTOR_TEMPERATURE=0.85
TUTOR_TOP_P=0.95
MIIT_TEMPERATURE=0.7
MIIT_TOP_P=0.9
# MIIT_RETRIEVAL=embed
# MIIT_MIN_SIMILARITY=0.55
# MIIT_TOP_K=3
# MIIT_INDEX_PATH=data/miit/index.json
# TUTOR_HYBRID_DEBUG=1

# Gradio UI (make app)
TUTOR_HOST=0.0.0.0
TUTOR_PORT=7860

# Litestar API (make serve-api)
TUTOR_API_HOST=0.0.0.0
TUTOR_API_PORT=8001
# TUTOR_CORS_ORIGINS=http://localhost:7860

# Optional: require X-API-Key on POST /v1/chat
# TUTOR_API_KEY=
# TUTOR_MAX_CODE_CHARS=16384

# Gradio read-aloud (edge-tts; needs outbound internet)
TUTOR_TTS_ENABLED=true
TUTOR_TTS_VOICE=my-MM-NilarNeural
TUTOR_TTS_AUTOPLAY=false
