# AAA pgvector (default when TUTOR_BACKEND=aaa)
DATABASE_URL=postgresql+asyncpg://aaa:aaa@localhost:5435/aaa
# Required for login tokens (use a long random string in production)
JWT_SECRET=change-me-in-production
# Comma-separated Gemini keys (AAA-style). Each key is one round-robin worker for
# chat, MIIT embed, router, and TTS pronunciation/spell helpers.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=120
# GEMINI_PREFLIGHT_PROBE=false
GEMINI_MAX_TOKENS=
GEMINI_COOLING_SECONDS=60
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TUTOR_TEMPERATURE=0.8
RAG_TOP_K=5
TTS_ENGLISH_RATE=-5%
# KNOWLEDGE_DIR=knowledge

# --- Tutor backend (CLI / hybrid) ---
# aaa = LangGraph + pgvector (AAA backend); hybrid = local index.json RAG
TUTOR_BACKEND=aaa
HYBRID_CHAT_PROVIDER=gemini
# Legacy single-key aliases (merged into the pool when set).
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
# Non-AAA optional: isolated key for router + speech-name JSON (hybrid path).
GEMINI_TTS_NAMES_API_KEY=
TUTOR_TEMPERATURE=0.85
TUTOR_TOP_P=0.95
MIIT_TEMPERATURE=0.7
MIIT_TOP_P=0.9
# Hybrid-only: MIIT_RETRIEVAL=embed, MIIT_INDEX_PATH=data/miit/index.json
# TUTOR_HYBRID_DEBUG=1

TUTOR_API_HOST=0.0.0.0
TUTOR_API_PORT=8001
TUTOR_CORS_ORIGINS=http://localhost:5173
# TUTOR_API_KEY=
# TUTOR_MAX_CODE_CHARS=16384

TUTOR_TTS_ENABLED=true
TUTOR_TTS_VOICE=my-MM-NilarNeural
TUTOR_TTS_AUTOPLAY=false
# false = AAA Gemini spell/roman/letter maps on prefetch; Listen still uses files only.
TTS_SKIP_GEMINI_HELPERS=false
