# =============================================================================
# Computer Engineering Tutor — root environment
#   cp .env.example .env
#   fill GEMINI_API_KEYS (and JWT_SECRET before production)
# Frontend (optional): web/.env.example → web/.env
# =============================================================================

# --- Postgres (TUTOR_BACKEND=aaa) ---
# Docker: make db-up  →  host port 5435, container programming-tutor-postgres
DATABASE_URL=postgresql+asyncpg://aaa:aaa@localhost:5435/aaa

# --- Auth (Litestar JWT for React login) ---
JWT_SECRET=change-me-in-production

# --- Gemini API pool (required) ---
# Comma-separated keys from Google AI Studio (usually AIza…). One round-robin pool
# for chat, MIIT embeddings, router, and TTS pronunciation/spell helpers (AAA).
GEMINI_API_KEYS=
# Legacy aliases (merged into the pool when GEMINI_API_KEYS is empty):
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
# Optional: dedicated key for router + speech-name JSON (else uses the pool).
GEMINI_TTS_NAMES_API_KEY=

# --- Models & limits ---
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMS=768
GEMINI_TIMEOUT_SECONDS=120
GEMINI_COOLING_SECONDS=60
# Empty = 2048 max output tokens (legacy alias: TUTOR_CLOUD_MAX_TOKENS)
GEMINI_MAX_TOKENS=
GEMINI_TUTOR_TEMPERATURE=0.8
GEMINI_PREFLIGHT_PROBE=true

# --- RAG (AAA pgvector under knowledge/) ---
RAG_TOP_K=5
# KNOWLEDGE_DIR=knowledge

# --- Tutor backend ---
# aaa     = LangGraph + Postgres sessions + pgvector (default; use make api + make web)
# hybrid  = local data/miit/index.json (make chat / smoke-hybrid)
TUTOR_BACKEND=aaa
HYBRID_CHAT_PROVIDER=gemini

# Hybrid-only (ignored when TUTOR_BACKEND=aaa):
# MIIT_RETRIEVAL=embed
# MIIT_INDEX_PATH=data/miit/index.json
# MIIT_MIN_SIMILARITY=0.55
# MIIT_TOP_K=5
# TUTOR_HYBRID_DEBUG=1

# --- Generation tuning (programming vs MIIT routes) ---
TUTOR_TEMPERATURE=0.85
TUTOR_TOP_P=0.95
MIIT_TEMPERATURE=0.7
MIIT_TOP_P=0.9

# --- Litestar API (make api → http://127.0.0.1:8001) ---
TUTOR_API_HOST=0.0.0.0
TUTOR_API_PORT=8001
TUTOR_CORS_ORIGINS=http://localhost:5173
# TUTOR_API_KEY=
# TUTOR_MAX_CODE_CHARS=16384

# --- Text-to-speech (edge-tts; outbound internet) ---
TUTOR_TTS_ENABLED=true
TUTOR_TTS_VOICE=my-MM-NilarNeural
TUTOR_TTS_AUTOPLAY=false
TTS_ENGLISH_RATE=-5%
# false = Gemini spell/roman/name maps during background speech prefetch
TTS_SKIP_GEMINI_HELPERS=false
# TTS_DATA_DIR=data

# --- Document vision (API upload routes; not exposed in React v1) ---
# GEMINI_VISION_MODEL=
# GEMINI_VISION_MAX_TOKENS=512
# GEMINI_VISION_TIMEOUT_SECONDS=360
# VISION_MAX_PDF_PAGES=0
# VISION_MAX_IMAGE_EDGE=768
